<odoo>
  <template id="patient_template">
      <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <div class="page">
          <h2 style="color: red;">Patient Status Report</h2>

          <div style="display: flex; justify-content: space-between;">
            <div>
              <p><strong>Name:</strong> <t t-esc="o.first_name"/></p>
              <p><strong>Age:</strong> <t t-esc="o.age"/></p>
              <p><strong>Department:</strong> <t t-esc="o.department_id.name"/></p>
              <p><strong>Doctors:</strong>
                <t t-esc="', '.join([d.first_name for d in o.doctor_ids])"/>
              </p>
            </div>
            <div>
              <img t-if="o.image" t-att-src="image_data_uri(o.image)" style="max-height: 120px;"/>
              <p><strong>Birth date:</strong> <t t-esc="o.birth_date"/></p>
              <p><strong>PCR:</strong> <t t-esc="o.pcr"/></p>
              <p><strong>Blood Type:</strong> <t t-esc="o.blood_type"/></p>
              <p><strong>Email:</strong> <t t-esc="o.email"/></p>
            </div>
          </div>

          <h4 style="color: red; margin-top: 20px;">Log History</h4>
          <table class="table table-sm table-bordered">
            <thead style="background-color: #007bff; color: white;">
              <tr>
                <th>User</th>
                <th>Date</th>
                <th>Info</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="o.log_history_ids" t-as="log">
                <td><t t-esc="log.patient_id.first_name"/></td>
                <td><t t-esc="log.date"/></td>
                <td><t t-esc="log.description"/></td>
              </tr>
            </tbody>
          </table>
        </div>
      </t>
    </t>
  </template>
</odoo>
