<odoo>
    <record id="view_ticket_tree" model="ir.ui.view">
        <field name="name">lr.ticket.list</field>
        <field name="model">lr.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="number"/>
                <field name="tag"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ticket_form" model="ir.ui.view">
        <field name="name">lr.ticket.form</field>
        <field name="model">lr.ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="number"/>
                        <field name="tag"/>
                        
                    </group>
                    <group> 
                        <field name="description"/>
                        <field name="file"/>
                        <field name="state"/>
                    
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">lr.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>